# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sams_social_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sams_social_dev
DB_USER=sams_user
DB_PASSWORD=password

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# JWT
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRY=7d

# Platform OAuth - TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Platform OAuth - Instagram/Meta
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# Platform OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# Platform OAuth - YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# AI/Content Generation
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Owner
OWNER_EMAIL=issam.salih@gmail.com
OWNER_APPROVAL_REQUIRED=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Features
ENABLE_AUTO_PUBLISH=false
ENABLE_MONETIZATION_TRACKING=false
ENABLE_ANALYTICS_SYNC=false
