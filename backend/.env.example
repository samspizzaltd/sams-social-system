# ═══════════════════════════════════════════════════════════════
# Sam's Autonomous Social Media System - Environment Configuration
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in the values below
# cp .env.example .env
#

# ─────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────
#
# Local PostgreSQL (for development):
# DATABASE_URL=postgresql://localhost/sams_social
#
# Production PostgreSQL (replace with your actual connection):
# DATABASE_URL=postgresql://user:password@host:5432/sams_social
#

DATABASE_URL=postgresql://localhost/sams_social

# ─────────────────────────────────────────────────────────────────
# OWNER CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# Owner email for notifications and admin access
#

OWNER_EMAIL=issam.salih@gmail.com

# ─────────────────────────────────────────────────────────────────
# CLAUDE API CONFIGURATION (Required for Phase 3: Content Creation)
# ─────────────────────────────────────────────────────────────────
#
# Get your API key from: https://console.anthropic.com
# Cost: Pay-as-you-go (~₾500/month for typical usage)
#
# How to get:
# 1. Go to https://console.anthropic.com
# 2. Sign up or login
# 3. Click "API Keys" in sidebar
# 4. Click "Create Key"
# 5. Copy the key (starts with sk-ant-)
#

CLAUDE_API_KEY=sk-ant-v0-REPLACE_WITH_YOUR_KEY

# ─────────────────────────────────────────────────────────────────
# TIKTOK OAUTH CONFIGURATION (Required for Phase 4: Publishing)
# ─────────────────────────────────────────────────────────────────
#
# Get credentials from: https://developers.tiktok.com
#
# Setup:
# 1. Sign up for TikTok Developer Account
# 2. Create Business App
# 3. Get Client ID and Client Secret
# 4. Set Redirect URI: http://localhost:3000/api/platforms/tiktok/auth
#

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────
# INSTAGRAM OAUTH CONFIGURATION (Required for Phase 4: Publishing)
# ─────────────────────────────────────────────────────────────────
#
# Get credentials from: https://developers.facebook.com
#
# Setup:
# 1. Create Meta Developer Account
# 2. Create Business App
# 3. Add Instagram Graph API product
# 4. Get App ID, App Secret, and Access Token
#

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────
# FACEBOOK OAUTH CONFIGURATION (Required for Phase 4: Publishing)
# ─────────────────────────────────────────────────────────────────
#
# Get credentials from: https://developers.facebook.com
# Same app as Instagram above
# Get App ID, App Secret, and Access Token
#

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────
# YOUTUBE OAUTH CONFIGURATION (Required for Phase 4: Publishing)
# ─────────────────────────────────────────────────────────────────
#
# Get credentials from: https://console.cloud.google.com
#
# Setup:
# 1. Create new Google Cloud Project
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 Client ID
# 4. Get Client ID, Client Secret, and Access Token
#

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional, but recommended for Phase 3+)
# ─────────────────────────────────────────────────────────────────
#
# SMTP Service options:
# - Gmail: https://myaccount.google.com (App Passwords)
# - SendGrid: https://sendgrid.com (API)
# - AWS SES: https://aws.amazon.com (SMTP credentials)
#
# For local testing: Leave these blank
#

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-api-key
SMTP_FROM=noreply@sams.social

# ─────────────────────────────────────────────────────────────────
# DASHBOARD CONFIGURATION
# ─────────────────────────────────────────────────────────────────
#

DASHBOARD_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────
# SECURITY CONFIGURATION (For Production)
# ─────────────────────────────────────────────────────────────────
#
# JWT_SECRET: Used to sign authentication tokens
# Minimum 32 characters, use a random string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#

JWT_SECRET=your-secret-key-min-32-chars-for-production

# ═══════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════
#
# NEVER commit this file to git. It contains sensitive credentials.
# Add .env to .gitignore (already done)
#
# For local development: Only DATABASE_URL and CLAUDE_API_KEY needed
# For Phase 4 testing: Add all platform OAuth credentials
# For production: All fields must be filled
#
# Phases:
# Phase 1: Foundation (DB, Auth, Dashboard) - No API keys needed
# Phase 2: Intelligence (Research) - No API keys needed
# Phase 3: Production (Content creation) - CLAUDE_API_KEY REQUIRED
# Phase 4: Distribution (Publishing) - All platform keys REQUIRED
# Phase 5: Analytics (Metrics) - Platform keys REQUIRED
# Phase 6: Optimization (Learning) - All systems REQUIRED
# Phase 7: Monetization (Revenue) - All systems REQUIRED
#
# ═══════════════════════════════════════════════════════════════
